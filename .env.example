# Copy to .env and edit. Never commit .env.
CI_ENVIRONMENT = production

app.baseURL = 'https://grievance.example.edu/'
app.indexPage = ''
app.appTimezone = 'UTC'
app.forceGlobalSecureRequests = true
app.sessionDriver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
app.sessionSavePath = 'ci_sessions'
app.sessionExpiration = 28800
app.sessionTimeToUpdate = 300
app.sessionMatchIP = false

database.default.hostname = 127.0.0.1
database.default.database = grievance_db
database.default.username = grievance
database.default.password = CHANGE_ME
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.schema = grievance
database.default.charset = UTF8
database.default.DBCollat =
database.default.DBDebug = false
# Always talk to PostgreSQL in UTC, whatever the server's own timezone is
database.default.options = '-c timezone=UTC'

# Timestamps are stored in UTC and shown in this timezone
portal.displayTimezone = 'Asia/Kolkata'

# ---------------------------------------------------------------------------------------------
# Sign in with Google (institute accounts). See docs/GOOGLE-LOGIN-AND-OTP.md for how to get these.
google.clientId     = 'CHANGE_ME.apps.googleusercontent.com'
google.clientSecret = 'CHANGE_ME'
# Optional; default is app.baseURL + auth/google/callback. Must match the "Authorised redirect URI" in Google Cloud.
# google.redirectUri = 'https://grievance.example.edu/auth/google/callback'
google.studentDomain = 'stu.manit.ac.in'
google.staffDomain   = 'manit.ac.in'
# Test sign-in without Google (type an e-mail). ONLY for development/testing on your own computer:
#   CI_ENVIRONMENT = development
#   google.devLogin = true

# ---------------------------------------------------------------------------------------------
# OTP before submitting a grievance (one code to e-mail and to the mobile number on the master list)
# 'smtp' = really send e-mail (needs the email.* lines below); 'log' = write it to writable/logs/otp-DATE.log
otp.emailMode = 'smtp'
# SMS: no gateway yet, so the SMS text is written to writable/logs/otp-DATE.log
otp.smsDriver = 'log'
otp.fromName  = 'MANIT Grievance Portal'

# E-mail through the institute's Google Workspace (an app password of a no-reply mailbox)
email.protocol   = 'smtp'
email.SMTPHost   = 'smtp.gmail.com'
email.SMTPPort   = 587
email.SMTPCrypto = 'tls'
email.SMTPUser   = 'grievance-noreply@manit.ac.in'
email.SMTPPass   = 'CHANGE_ME_APP_PASSWORD'
email.fromEmail  = 'grievance-noreply@manit.ac.in'
email.mailType   = 'text'
email.SMTPTimeout = 15

# ---------------------------------------------------------------------------------------------------------
# Institute ERP (read-only). Used when the setting person_source = 'erp'  (php spark portal:person-source erp)
# DUMMY ERP: the values below point at the dummy ERP databases made for development. Replace host, database,
# user and password with the real ERP's (use a READ-ONLY account) and adjust app/Config/Erp.php to the real
# table and column names.
# ---------------------------------------------------------------------------------------------------------
database.erp.hostname = 127.0.0.1
database.erp.database = erp_dummy
database.erp.username = portal_ro
database.erp.password = CHANGE_ME
database.erp.DBDriver = Postgre
database.erp.port = 5432
# The hostel records are a separate database
database.erp_hostel.hostname = 127.0.0.1
database.erp_hostel.database = erp_hostel_dummy
database.erp_hostel.username = portal_ro
database.erp_hostel.password = CHANGE_ME
database.erp_hostel.DBDriver = Postgre
database.erp_hostel.port = 5432
